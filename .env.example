# 肿瘤登记增量同步 · 环境变量样例
# 用法：cp .env.example .env 后按院内实际情况填写；.env 已被 .gitignore 排除，禁止提交。
# 凭据一律只从环境变量读取，代码中不得出现任何真实地址或令牌。

# ── 院内权威数据源（FHIR R4 只读）────────────────────────────
# CDR（临床数据仓库 / 院内 FHIR 服务）的基地址，不带结尾斜杠
CDR_BASE_URL=https://cdr.example-hospital.internal
# CDR 访问令牌（Bearer）
CDR_API_TOKEN=replace-with-cdr-token
# 登记主索引在 Patient.identifier 上使用的 system 值，token 检索形如 {system}|{value}
CDR_IDENTIFIER_SYSTEM=urn:oid:2.16.156.10011.0.1

# ── 专病库登记接口（出站写）──────────────────────────────────
# 专病库登记接口基地址，不带结尾斜杠
REGISTRY_BASE_URL=https://registry.example-hospital.internal
# 专病库访问令牌（Bearer）
REGISTRY_API_TOKEN=replace-with-registry-token
# 推送体形态：field-level=字段级增量（默认）；whole-entry=整条但只带变化字段
REGISTRY_PAYLOAD_FORM=field-level

# ── 语义归并与差异解释（OpenAI-compatible，ai_role=assist）────
# 三项要么全部配置、要么全部不配；只配一项会在启动时报错并指名缺哪个变量
MODEL_BASE_URL=https://model-gateway.example-hospital.internal/v1
MODEL_API_KEY=replace-with-model-token
MODEL_NAME=clinical-merge-model
# 模型调用超时（毫秒），默认 20000
MODEL_TIMEOUT_MS=20000

# ── 运行期行为开关 ──────────────────────────────────────────
# 检索并发上限，默认 4
FHIR_MAX_CONCURRENCY=4
# 归并置信度阈值，低于该值标「需人工判定」且建议值留空，默认 0.80
MERGE_CONFIDENCE_THRESHOLD=0.80
# 本机结构化运行日志（JSONL）所在目录，默认 logs；记录每行的阶段、错误码、耗时与尝试次数
RUN_LOG_DIR=logs
